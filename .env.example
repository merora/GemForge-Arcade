# ตัวอย่างไฟล์ตั้งค่า — คัดลอกเป็น .env แล้วกรอกค่าจริงใน .env เท่านั้น
# ไฟล์นี้ commit ได้ (ไม่มีความลับ) ส่วน .env ห้าม commit

# Private key ของกระเป๋า "สำหรับทดสอบเท่านั้น" (64 ตัวอักษรฐาน 16, มี 0x หรือไม่ก็ได้)
PRIVATE_KEY=

# RPC ของ Sepolia (ใช้ public node ได้เลย หรือเปลี่ยนเป็น Alchemy / Infura ของตัวเอง)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# RPC ของ Base Sepolia (Layer 2)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
